---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts, formatDate } from "../../data/blog";

const navItems = [
  { label: "Home", href: "/" },
  { label: "Portfolio", href: "/portfolio" },
  { label: "Projects", href: "/projects" },
  { label: "Blog", href: "/blog" },
  { label: "YouTube", href: "/youtube" },
  { label: "Contact", href: "mailto:prashantchaturvedi2020@gmail.com" },
];
---

<Layout title="Blog — Prashant Chaturvedi">
  <Nav items={navItems} />
  <main class="page">
    <div class="container">
      <h1 class="page-title">Blog</h1>
      <p class="page-subtitle">Thoughts on programming, data science, and technology</p>

      <div class="preview-list">
        {blogPosts.map((post) =>
          post.status === "published" ? (
            <a href={`/blog/${post.slug}`} class="preview-card">
              <div class="preview-tag" style="color: var(--teal); background: rgba(20,184,166,0.08);">New</div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
              <div class="preview-meta">{formatDate(post.date!)} · {post.readingTime}</div>
            </a>
          ) : (
            <article class="preview-card">
              <div class="preview-tag">Coming</div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </article>
          )
        )}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
